# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel
# (Project → Settings → Environment Variables).
# Supabase → Project Settings → API Keys: URL do projeto e a chave "publishable" (ou a "anon" antiga).
# As duas são públicas por natureza: quem protege os dados são as regras de supabase/schema.sql.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
